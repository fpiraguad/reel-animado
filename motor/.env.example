# Copia este archivo a .env y llena los valores. .env no se sube al repo.

# Clave de la API de ElevenLabs (elevenlabs.io → Profile → API keys). La usa `npm run voz`.
ELEVENLABS_API_KEY=
# ID de la voz que narrará los reels (una voz de tu biblioteca de ElevenLabs o tu voz clonada).
ELEVENLABS_VOICE_ID=
# Clave de la API de OpenAI (platform.openai.com → API keys). Opcional: solo para generar imágenes con `node scripts/imagen.mjs`.
OPENAI_API_KEY=
